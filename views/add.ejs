<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Add Student</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header') %>

    <main class="container">
        
        <h2>Add Student</h2>

        <% if (errors && errors.length) { %>
            <div class="alert">
                <ul>
                    <% errors.forEach(e => { %><li><%= e %></li><% }); %>
                </ul>
            </div>
        <% } %>

        <form action="/students/add" method="POST" class="card">
            <label>Student ID</label>
            <input type="text" name="student_id" value="<%= student.student_id || '' %>" required>

            <label>First Name</label>
            <input type="text" name="first_name" value="<%= student.first_name || '' %>" required>

            <label>Last Name</label>
            <input type="text" name="last_name" value="<%= student.last_name || '' %>" required>

            <label>Course</label>
            <input type="text" name="course" value="<%= student.course || '' %>" required>

            <label>Year Level</label>
            <input type="number" name="year_level" min="1" max="5" value="<%= student.year_level || '' %>" required>

            <label>Email</label>
            <input type="email" name="email" value="<%= student.email || '' %>" required>

            <button type="submit" class="btn">Save Student</button>
            <a href="/" class="btn btn-gray">Back to Student List</a>
        </form>
    </main>
</body>
</html>